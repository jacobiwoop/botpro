<?xml version="1.0" encoding="utf-8"?>
<!-- Bulle de message (reproduit ChatMessageCell de Telegram) -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bubble_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/bubble_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="64dp"
        android:background="@color/bubble_in"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:maxWidth="320dp">

        <!-- Texte du message -->
        <TextView
            android:id="@+id/message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_bubble_in"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.15"
            tools:text="Bonjour ! Comment puis-je vous aider ?" />

        <!-- Heure du message -->
        <TextView
            android:id="@+id/time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_time_in"
            android:textSize="11sp"
            tools:text="14:32" />

        <!-- Clavier inline bot (boutons sous le message) -->
        <LinearLayout
            android:id="@+id/inline_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
