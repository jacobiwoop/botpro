<?xml version="1.0" encoding="utf-8"?>
<!-- Item de conversation (DialogCell de Telegram reproduit en XML) -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Avatar rond (comme DialogCell de Telegram) -->
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_centerVertical="true">

        <View
            android:id="@+id/avatar_view"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@android:color/holo_blue_dark" />

        <TextView
            android:id="@+id/avatar_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="A" />

        <!-- Indicateur en ligne (point vert comme Telegram) -->
        <View
            android:id="@+id/online_indicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:background="@color/status_online"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Heure du dernier message (alignée à droite, comme Telegram) -->
    <TextView
        android:id="@+id/time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:textColor="@color/dialog_date"
        android:textSize="12sp"
        tools:text="14:32" />

    <!-- Nom du bot -->
    <TextView
        android:id="@+id/name_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_toEndOf="@id/avatar_container"
        android:layout_toStartOf="@id/time_text"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/dialog_name"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Assistant IA" />

    <!-- Badge messages non lus (bulle bleue Telegram) -->
    <TextView
        android:id="@+id/unread_badge"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/time_text"
        android:layout_marginTop="4dp"
        android:background="@color/unread_badge"
        android:gravity="center"
        android:minWidth="22dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="2"
        tools:visibility="visible" />

    <!-- Dernier message -->
    <TextView
        android:id="@+id/message_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/name_text"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:layout_toEndOf="@id/avatar_container"
        android:layout_toStartOf="@id/unread_badge"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/dialog_message"
        android:textSize="14sp"
        tools:text="Bonjour ! Comment puis-je vous aider ?" />

    <!-- Divider (comme Telegram, indenté sous l'avatar) -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="84dp"
        android:background="@color/divider" />

</RelativeLayout>
