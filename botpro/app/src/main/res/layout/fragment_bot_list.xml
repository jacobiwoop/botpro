<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_window">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Action Bar / En-tête : fond #1D2733 (se fond avec la liste), padding top géré dynamiquement par WindowInsets -->
        <LinearLayout
            android:id="@+id/header_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_window"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:textColor="@color/actionbar_title"
                android:textSize="20dp"
                android:text="@string/bot_list_title"
                tools:text="BotPro" />

            <ImageView
                android:id="@+id/btn_search"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:padding="12dp"
                android:src="@drawable/msg_search"
                android:contentDescription="@string/search"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/actionbar_icon" />

            <ImageView
                android:id="@+id/btn_more"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:padding="12dp"
                android:src="@drawable/ic_ab_other"
                android:contentDescription="Plus d'options"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/actionbar_icon" />
        </LinearLayout>

        <!-- Liste des conversations (RecyclerView fond #1D2733) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bg_window"
            android:overScrollMode="never"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- Vue vide optionnelle -->
    <LinearLayout
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bot_list_empty"
            android:textColor="@color/text_primary"
            android:textSize="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/bot_list_empty_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Bouton d'action flottant (Cercle parfait 56dp, fond #5FA3DE, icône blanche) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Nouvelle conversation"
        android:src="@drawable/floating_pencil"
        app:backgroundTint="@color/fab_bg"
        app:tint="@color/fab_icon"
        app:fabCustomSize="56dp"
        app:maxImageSize="28dp"
        app:elevation="6dp"
        app:borderWidth="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.BotPro.FabCircle" />

</FrameLayout>
