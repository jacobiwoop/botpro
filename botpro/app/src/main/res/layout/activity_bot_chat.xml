<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de conversation BotPro (reproduction exacte de Telegram ChatActivity) -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151E27">

    <!-- ═══ 1. Liste des messages (défile SOUS la barre flottante, conv-04) ═══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/chat_bottom_container"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

    <!-- ═══ 2. Barre du haut FLOTTANTE (insets-aware, conv-01, conv-08) ═══ -->
    <FrameLayout
        android:id="@+id/chat_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#1D2733">

        <!-- Barre normale -->
        <RelativeLayout
            android:id="@+id/chat_toolbar_content"
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <!-- Bouton retour (54.2 × 56 dp) -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="54dp"
                android:layout_height="56dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="16dp"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Retour"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Avatar (41.5 × 41.5 dp, x=166px) -->
            <FrameLayout
                android:id="@+id/toolbar_avatar_container"
                android:layout_width="41.5dp"
                android:layout_height="41.5dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btn_back"
                android:layout_marginStart="4dp">

                <View
                    android:id="@+id/toolbar_avatar_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#5CAFFA" />

                <TextView
                    android:id="@+id/toolbar_avatar_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="M" />
            </FrameLayout>

            <!-- Titre et sous-titre (largeur bot: 218.5dp) -->
            <LinearLayout
                android:id="@+id/toolbar_title_container"
                android:layout_width="218.5dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/toolbar_avatar_container"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Moodwoop 🫥" />

                <TextView
                    android:id="@+id/toolbar_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#7D8B99"
                    android:textSize="13sp"
                    tools:text="bot" />
            </LinearLayout>

            <!-- Menu ⋮ (42.9 × 56 dp) -->
            <ImageView
                android:id="@+id/btn_header_menu"
                android:layout_width="43dp"
                android:layout_height="56dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="16dp"
                android:src="@android:drawable/ic_menu_more"
                android:contentDescription="Menu"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>

        <!-- Barre mode sélection (conv-03) -->
        <RelativeLayout
            android:id="@+id/chat_selection_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btn_close_selection"
                android:layout_width="54dp"
                android:layout_height="56dp"
                android:padding="16dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Fermer"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/selection_count_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/btn_close_selection"
                android:gravity="center_vertical"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="1 sélectionné" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_copy_selection"
                    android:layout_width="48dp"
                    android:layout_height="56dp"
                    android:padding="14dp"
                    android:src="@android:drawable/ic_menu_manage"
                    android:contentDescription="Copier"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <ImageView
                    android:id="@+id/btn_forward_selection"
                    android:layout_width="48dp"
                    android:layout_height="56dp"
                    android:padding="14dp"
                    android:src="@android:drawable/ic_menu_share"
                    android:contentDescription="Transférer"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <ImageView
                    android:id="@+id/btn_delete_selection"
                    android:layout_width="43dp"
                    android:layout_height="56dp"
                    android:padding="14dp"
                    android:src="@android:drawable/ic_menu_delete"
                    android:contentDescription="Supprimer"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>

    <!-- ═══ 3. Conteneur Bas (Barre de saisie adaptative 3 états + Claviers de bot) ═══ -->
    <LinearLayout
        android:id="@+id/chat_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <!-- Menu de commandes coulissant (conv-10) -->
        <com.botpro.app.ui.chat.BotCommandMenuView
            android:id="@+id/bot_command_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Clavier de réponse de bot (conv-09) -->
        <com.botpro.app.ui.chat.BotKeyboardView
            android:id="@+id/bot_keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Barre de saisie standard (51.3dp = 141px @440dpi) -->
        <LinearLayout
            android:id="@+id/chat_input_container"
            android:layout_width="match_parent"
            android:layout_height="51.3dp"
            android:background="#1D2733"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Bouton "☰ Menu" (82.5dp fond #229AF0 en conv-08 / 44dp rond en conv-09) -->
            <TextView
                android:id="@+id/btn_bot_menu"
                android:layout_width="82.5dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="#229AF0"
                android:text="☰ Menu"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Bouton Emoji (44 × 44 dp) -->
            <ImageView
                android:id="@+id/btn_emoji"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@android:drawable/btn_star_big_off"
                android:contentDescription="Emoji"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Champ de saisie (Largeur adaptative : 233.8dp normal / 96.4dp bot fermé / 138.9dp bot ouvert) -->
            <EditText
                android:id="@+id/chat_input_field"
                android:layout_width="0dp"
                android:layout_height="40.4dp"
                android:layout_weight="1"
                android:background="#242F3D"
                android:hint="Message"
                android:textColor="#FFFFFF"
                android:textColorHint="#7D8B99"
                android:textSize="16sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:maxLines="4"
                android:inputType="textMultiLine" />

            <!-- Bouton Clavier de Bot (Grille 44 × 44 dp) -->
            <ImageView
                android:id="@+id/btn_bot_keyboard_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@android:drawable/ic_dialog_dialer"
                android:contentDescription="Bot Keyboard"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Bouton Pièce jointe (44 × 44 dp) -->
            <ImageView
                android:id="@+id/btn_attach"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_add"
                android:contentDescription="Pièce jointe"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Bouton Micro / Envoyer (44 × 44 dp) -->
            <ImageView
                android:id="@+id/btn_send_or_mic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="Vocal ou Envoi"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Barre mode sélection (conv-03) : Reply / Forward -->
        <LinearLayout
            android:id="@+id/selection_bottom_container"
            android:layout_width="match_parent"
            android:layout_height="51.3dp"
            android:background="#1D2733"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_selection_reply"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Reply"
                android:textColor="#64B5EF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_selection_forward"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Forward"
                android:textColor="#64B5EF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
