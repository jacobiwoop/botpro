<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base BotPro Theme (Dark Blue — fidèle à Telegram) -->
    <style name="Theme.BotPro" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:windowBackground">@color/bg_window</item>
        <item name="android:statusBarColor">@color/actionbar_bg</item>
        <item name="android:navigationBarColor">@color/bg_tab_bar</item>
        <item name="android:colorBackground">@color/bg_surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_surface_elevated</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.BotPro.Splash" parent="Theme.BotPro">
        <item name="android:windowBackground">@color/bg_splash</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
    </style>

    <!-- ActionBar Style -->
    <style name="BotPro_ActionBar" parent="">
        <item name="android:background">@color/actionbar_bg</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Chat Input Style -->
    <style name="BotPro_ChatInput" parent="">
        <item name="android:background">@color/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- Bot Keyboard Button Style -->
    <style name="BotPro_BotKeyboardButton" parent="">
        <item name="android:background">@color/bot_keyboard_button</item>
        <item name="android:textColor">@color/bot_keyboard_button_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Dialog List Item Style -->
    <style name="BotPro_DialogItem" parent="">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Message Bubble Out -->
    <style name="BotPro_Bubble_Out" parent="">
        <item name="android:background">@color/bubble_out</item>
        <item name="android:textColor">@color/text_on_bubble_out</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Message Bubble In -->
    <style name="BotPro_Bubble_In" parent="">
        <item name="android:background">@color/bubble_in</item>
        <item name="android:textColor">@color/text_on_bubble_in</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Text Appearances -->
    <style name="BotPro_TextAppearance_Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="BotPro_TextAppearance_Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BotPro_TextAppearance_Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="BotPro_TextAppearance_Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- FAB Circle Style (Cercle parfait 56dp) -->
    <style name="ShapeAppearance.BotPro.FabCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
